generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  plan            PlanType         @default(FREE)
  role            Role             @default(USER)
  avatar          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isLive          Boolean          @default(false)
  pendingEmail    String?
  planExpiredAt   DateTime?
  emailVerified   DateTime?
  lastUsernameChange DateTime?
  accounts        Account[]
  activities      Activity[]
  adminNotes      AdminNote[]
  analytics       Analytics[]
  canvaProjects   CanvaProject[]
  certificates    Certificate[]
  couponUsages    CouponUsage[]
  dailyStats      DailyStats[]
  hourlyStats     HourlyStats[]
  dailyDeviceStats    DailyDeviceStats[]
  dailyReferrerStats  DailyReferrerStats[]
  dailyLocationStats  DailyLocationStats[]
  integrations    Integration[]
  links           Link[]
  pageBlocks      PageBlock[]
  profile         Profile?
  projects        Project[]
  siteAppearance  SiteAppearance?
  subscriptions   Subscription[]
  testimonials    Testimonial[]
  themeDrafts     ThemeDraft[]
  themeFavorites  ThemeFavorite[]
  transactions    Transaction[]
  visitorSessions VisitorSession[]
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Profile {
  id               String  @id @default(uuid())
  userId           String  @unique
  fullName         String
  subdomain        String? @unique
  profession       String?
  bio              String? @db.Text
  avatarUrl        String? @db.Text
  coverUrl         String? @db.Text
  location         String?
  availableForHire Boolean @default(true)
  whatsapp         String?
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fullName])
}

model SiteAppearance {
  id               String  @id @default(uuid())
  userId           String  @unique
  splashScreen     Boolean @default(false)
  themeTemplate    String  @default("minimalist")
  favoriteThemes   String  @default("[]") @db.Text
  customTexts      String  @default("{}") @db.Text
  designTokens     String? @db.Text
  publishedDraftId String?
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects         LiveThemeProject[]
}

model ThemeDraft {
  id            String   @id @default(uuid())
  userId        String
  name          String   @default("Draft Baru")
  themeTemplate String
  splashScreen  Boolean
  customTexts   String   @db.Text
  designTokens  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  description   String?  @db.Text
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects      ThemeDraftProject[]

  @@index([userId])
}

model ThemeFavorite {
  id        String   @id @default(uuid())
  userId    String
  themeId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, themeId])
  @@index([themeId])
  @@index([userId])
}

model Link {
  id       String  @id @default(uuid())
  userId   String
  platform String
  url      String  @db.Text
  isActive Boolean @default(true)
  order    Int     @default(0)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Link_userId_fkey")
}

model Project {
  id          String           @id @default(uuid())
  title       String
  description String?
  mediaUrl    String?
  projectType String           @default("photo")
  userId      String
  createdAt   DateTime         @default(now())
  tags        String           @default("[]") @db.Text
  deletedAt   DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  detail3D    Project3DDetail?
  themeDrafts ThemeDraftProject[]
  liveThemes  LiveThemeProject[]

  @@index([createdAt])
  @@index([deletedAt])
  @@index([userId], map: "Project_userId_fkey")
}

model Project3DDetail {
  id          String  @id @default(cuid())
  projectId   String  @unique
  fileSize    Int
  storagePath String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Activity {
  id         String   @id @default(uuid())
  userId     String
  actionType String
  details    String   @db.Text
  ipAddress  String?
  userAgent  String?
  location   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

model Certificate {
  id          String    @id @default(uuid())
  title       String
  issuer      String?
  year        String?
  status      String?   @default("VERIFIED")
  description String?   @db.Text
  mediaUrl    String?
  userId      String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Certificate_userId_fkey")
  @@index([deletedAt])
}

model Announcement {
  id         String   @id @default(uuid())
  title      String
  message    String   @db.Text
  type       String   @default("INFO")
  channel    String   @default("BOTH")
  targetPlan String   @default("ALL")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

model AdminLog {
  id         String   @id @default(uuid())
  adminEmail String
  action     String
  category   String   @default("GENERAL")
  target     String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([category])
  @@index([adminEmail])
}

model Analytics {
  id          String          @id @default(uuid())
  userId      String
  sessionId   String?
  type        String          @default("VIEW")
  ipAddress   String?
  userAgent   String?         @db.Text
  referrer    String?         @db.Text
  pagePath    String?
  duration    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  action      String?
  browser     String?
  city        String?
  country     String?
  deviceType  String?
  metadata    String?         @db.LongText
  os          String?
  targetId    String?
  utmCampaign String?
  utmMedium   String?
  utmSource   String?
  session     VisitorSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type])
  @@index([sessionId])
  @@index([userId], map: "Analytics_userId_fkey")
  @@index([userId, createdAt])
}

model VisitorSession {
  id          String      @id @default(uuid())
  userId      String
  visitorId   String
  referrer    String?     @db.Text
  source      String?
  duration    Int         @default(0)
  isBounced   Boolean     @default(true)
  country     String?
  city        String?
  deviceType  String?
  os          String?
  browser     String?
  ipAddress   String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  logs        Analytics[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([visitorId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Transaction {
  id             String   @id @default(cuid())
  userId         String
  amount         Int
  status         String
  plan           PlanType
  createdAt      DateTime @default(now())
  durationDays   Int      @default(30)
  gateway        String?
  subscriptionId String?
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId], map: "Transaction_userId_fkey")
}

model DailyStats {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  views     Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
}

model DailyDeviceStats {
  id         String   @id @default(uuid())
  userId     String
  date       DateTime
  deviceType String   @default("Desktop")
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, deviceType])
  @@index([date])
  @@index([userId])
}

model DailyReferrerStats {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  referrer  String   @default("Direct")
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, referrer])
  @@index([date])
  @@index([userId])
}

model DailyLocationStats {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  country   String   @default("Unknown")
  city      String   @default("Unknown")
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, country, city])
  @@index([date])
  @@index([userId])
}

model HourlyStats {
  id        String   @id @default(uuid())
  userId    String
  dateHour  DateTime
  views     Int      @default(0)
  visitors  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateHour])
  @@index([dateHour])
  @@index([userId])
}

model LoginAttempt {
  id        String    @id @default(uuid())
  ip        String
  email     String
  count     Int       @default(1)
  isBlocked Boolean   @default(false)
  blockedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([email])
  @@index([ip])
}

model RegisterAttempt {
  id        String   @id @default(uuid())
  ip        String
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([ip])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  plan      PlanType
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiredAt DateTime?
  grantedBy String?
  notes     String?            @db.Text
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiredAt])
}

model Integration {
  id             String    @id @default(uuid())
  userId         String
  provider       String
  providerId     String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  cacheExpiresAt DateTime?
  cachedData     String?   @db.LongText
  accessToken    String?   @db.Text
  settings       String?   @db.Text
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model CanvaProject {
  id        String   @id @default(uuid())
  userId    String
  title     String
  embedLink String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Testimonial {
  id         String   @id @default(uuid())
  userId     String
  clientName String
  company    String?
  content    String   @db.Text
  rating     Int      @default(5)
  avatarUrl  String?
  isVisible  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PricingPlan {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  monthlyPrice    Int
  monthlyOriginal Int
  yearlyPrice     Int
  yearlyOriginal  Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
}

model Coupon {
  id             String        @id @default(uuid())
  code           String        @unique
  discountType   DiscountType  @default(PERCENTAGE)
  discountValue  Int
  maxUses        Int?
  currentUses    Int           @default(0)
  validFrom      DateTime      @default(now())
  validUntil     DateTime?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  maxUsesPerUser Int?
  allowedPlan    String?       @default("ALL")
  minPurchase    Int?
  usages         CouponUsage[]

  @@index([code])
}

model CouponUsage {
  id       String   @id @default(uuid())
  userId   String
  couponId String
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([couponId])
}

model PageBlock {
  id         String   @id @default(uuid())
  userId     String
  blockType  String
  orderIndex Int      @default(0)
  isVisible  Boolean  @default(true)
  configJson String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, orderIndex])
}

model AdminNote {
  id          String   @id @default(uuid())
  userId      String
  type        String   @default("IDEA")
  content     String   @db.Text
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ThemeDraftProject {
  id            String     @id @default(uuid())
  themeDraftId  String
  projectId     String
  orderIndex    Int        @default(0)
  createdAt     DateTime   @default(now())

  themeDraft    ThemeDraft @relation(fields: [themeDraftId], references: [id], onDelete: Cascade)
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([themeDraftId, projectId])
  @@index([themeDraftId, orderIndex])
  @@index([projectId])
}

model LiveThemeProject {
  id                String         @id @default(uuid())
  siteAppearanceId  String
  projectId         String
  orderIndex        Int            @default(0)
  createdAt         DateTime       @default(now())

  siteAppearance    SiteAppearance @relation(fields: [siteAppearanceId], references: [id], onDelete: Cascade)
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([siteAppearanceId, projectId])
  @@index([siteAppearanceId, orderIndex])
  @@index([projectId])
}

enum PlanType {
  FREE
  PRO
  SUPREME
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum Role {
  USER
  ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED
}
