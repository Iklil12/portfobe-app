generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. TABEL USER (Khusus Keamanan & Login)
model User {
  id          String    @id @default(uuid())
  email       String    @unique 
  password    String    
  plan        String    @default("FREE")
  avatar      String  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relasi: 1 User punya 1 Profile, dan bisa punya banyak Links & Projects
  profile     Profile?  
  links       Link[]    
  projects    Project[] 
  activities Activity[]
}

// 2. TABEL PROFILE (Khusus Tampilan Visual Portofolio)
model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName         String
  subdomain        String?  @unique
  profession       String?
  bio              String?  @db.Text
  avatarUrl        String?  @db.Text
  coverUrl         String?  @db.Text
  location         String?
  availableForHire Boolean  @default(true)
  whatsapp         String?
  splashScreen Boolean @default(true)
  // --- SISTEM TEMA & DESAIN (BARU) ---
  themeTemplate    String   @default("minimalist") // Preset awal (cth: "brutalism", "minimalist")
  themeColor       String   @default("#000000")    // Warna utama/aksen
  fontHeading      String   @default("Inter")      // Font untuk Judul
  fontBody         String   @default("Inter")      // Font untuk Teks Biasa
  buttonShape      String   @default("rounded")    // Bentuk tombol: "hard" (kotak), "rounded", "pill"
  cardStyle        String   @default("flat")       // Gaya kartu: "flat", "hard-shadow", "glass"
}

// 3. TABEL LINK (Khusus Daftar Sosial Media & Tautan)
model Link {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  platform    String   // Contoh: "TikTok", "Instagram", "Website"
  url         String   @db.Text
  isActive    Boolean  @default(true)
  order       Int      @default(0) // Untuk mengatur urutan tampilan
}

// 4. TABEL PROJECT (Karya/Portofolio)
model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  mediaUrl    String?
  projectType String   @default("photo") // <--- TAMBAHKAN BARIS INI
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) // (Opsional) Tambahkan ini agar bisa diurutkan dari yang terbaru
}
// BARIS BARU: 5. TABEL ACTIVITY (Log Aktivitas User)
model Activity {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  actionType  String   // Contoh: "ADD_LINK", "UPDATE_PROFILE", "CHANGE_THEME"
  details     String   @db.Text // Penjelasan aktivitas
  createdAt   DateTime @default(now())
}